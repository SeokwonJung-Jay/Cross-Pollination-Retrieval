# Copy to .env (git-ignored) and fill in what you need. Values in the environment take precedence.

# dataset/ (LLM stages)
OPENAI_API_KEY=
# evaluation/reranker, evaluation/rewriting (generation)
OPENROUTER_API_KEY=
# evaluation/main (Gemini Embedding), evaluation/rewriting (scoring)
GEMINI_API_KEY=

# Optional
# Semantic Scholar API (fetch_abstracts.py --api, dataset/)
S2_API_KEY=
# ablation/domain/fetch_openalex.py
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
# Hugging Face downloads
HF_TOKEN=
# training logs (W&B is off without WANDB_API_KEY)
WANDB_API_KEY=
WANDB_ENTITY=
